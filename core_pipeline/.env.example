# Copy this file to .env and fill your keys.
# Comma-separated key pools and indexed names such as GEMINI_API_KEY_1,
# GEMINI_API_KEY_2 are both supported.

GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GITHUB_API_KEYS=
GITHUB_API_KEY=
GROQ_API_KEYS=
GROQ_API_KEY=
MISTRAL_API_KEYS=
MISTRAL_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=
CEREBRAS_API_KEYS=
CEREBRAS_API_KEY=
FIREWORKS_API_KEYS=
FIREWORKS_API_KEY=
CLOUDFLARE_WORKERS_API_KEYS=
CLOUDFLARE_WORKERS_API_KEY=
# Use one account id for all Cloudflare keys, or comma-match account ids in the same order as keys.
CLOUDFLARE_ACCOUNT_IDS=
CLOUDFLARE_ACCOUNT_ID=
PREFERRED_PROVIDER=

# Step 7 API translation.
# `auto` enables API translation whenever any provider key above is configured.
# Use `0` to disable provider calls and rely on local fallback behavior only.
USE_API_TRANSLATION=auto
LOCAL_TRANSLATOR_MODEL=facebook/nllb-200-distilled-600M

# Provider order is comma-separated. The pipeline tries each provider until all
# OCR text fragments receive accepted English translations.
# Ordered strongest-healthy-first for translation quality (2026-07-15 pass);
# providers with revoked/locked keys are kept at the tail rather than removed
# so they resume automatically once keys are rotated.
TRANSLATION_PROVIDER_ORDER=mistral,cerebras,fireworks,groq,nvidia,github,openrouter,gemini,cloudflare

# Optional model overrides.
GEMINI_TRANSLATION_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_TRANSLATION_MODEL=gemini-flash-latest
MISTRAL_TRANSLATION_MODELS=mistral-large-latest,mistral-small-latest,mistral-medium-latest
MISTRAL_TRANSLATION_MODEL=mistral-large-latest
GITHUB_TRANSLATION_MODELS=openai/gpt-4o-mini,openai/gpt-4.1-mini,mistral-ai/mistral-small-2503
GITHUB_TRANSLATION_MODEL=openai/gpt-4o-mini
FIREWORKS_TRANSLATION_MODELS=accounts/fireworks/models/kimi-k2p6,accounts/fireworks/models/glm-5p1,accounts/fireworks/models/deepseek-v4-pro,accounts/fireworks/models/glm-5p2,accounts/fireworks/models/gpt-oss-120b
FIREWORKS_TRANSLATION_MODEL=accounts/fireworks/models/kimi-k2p6
OPENROUTER_TRANSLATION_MODELS=tencent/hy3:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,meta-llama/llama-3.3-70b-instruct:free,cohere/north-mini-code:free,google/gemini-2.5-flash,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_TRANSLATION_MODEL=tencent/hy3:free
GROQ_TRANSLATION_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b,qwen/qwen3-32b,llama-3.1-8b-instant
GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TRANSLATION_MODELS=zai-glm-4.7,gemma-4-31b,gpt-oss-120b
CEREBRAS_TRANSLATION_MODEL=zai-glm-4.7
CLOUDFLARE_TRANSLATION_MODELS=@cf/qwen/qwen3-30b-a3b-fp8,@cf/qwen/qwq-32b,@cf/deepseek-ai/deepseek-r1-distill-qwen-32b,@cf/qwen/qwen1.5-14b-chat-awq,@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TRANSLATION_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Optional NVIDIA NIM support. Add singular values or comma-separated plural values.
NVIDIA_API_KEYS=
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEYS=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TRANSLATION_MODELS=meta/llama-3.1-70b-instruct,qwen/qwen3-5-122b-a10b,qwen/qwen3.5-397b-a17b,mistralai/mistral-7b-instruct-v0.3,meta/llama-3.1-8b-instruct
NVIDIA_NIM_TRANSLATION_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_VISION_OCR_MODELS=nvidia/llama-3.1-nemotron-nano-vl-8b-v1,meta/llama-3.2-11b-vision-instruct,meta/llama-3.2-90b-vision-instruct
NVIDIA_NIM_VISION_OCR_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1

API_TRANSLATION_MAX_TOKENS=1400
API_TRANSLATION_TIMEOUT_SECONDS=45
API_TRANSLATION_RETRIES_PER_PROVIDER=2

# Runtime model residency controls.
# Startup warmup improves first-request latency but can block early requests while
# large models load. Keep it off for reliable browser-extension startup.
FMT_STARTUP_WARMUP=0
# Set to 0 to disable automatic idle GPU release. 600 unloads models after 10 idle minutes.
FMT_GPU_IDLE_UNLOAD_SECONDS=600

# Local training-data collection for future VLM fine-tuning.
# Values: off, failure, review, all. Review exports only failed/review-worthy cases.
FMT_TRAINING_DATA_EXPORT=review
FMT_TRAINING_DATA_EXPORT_ROOT=training_data/failure_cases
FMT_TRAINING_DATA_EXPORT_MAX_REGIONS=48

# Hardened API quota manager. Usage is tracked locally under runtime_samples.
# The manager silently rotates keys at 80% of each safe local budget and locks
# keys for 24 hours after 402/429/insufficient_quota/rate-limit responses.
API_MANAGER_SOFT_CAP_RATIO=0.80
API_MANAGER_MINUTE_SOFT_CAP_RATIO=0.90
API_MANAGER_EXHAUSTED_LOCK_HOURS=24
API_MANAGER_DEFAULT_LIMIT_SCOPE=provider
API_MANAGER_DEFAULT_DAILY_TOKENS=50000
API_MANAGER_DEFAULT_DAILY_REQUESTS=200
API_MANAGER_DEFAULT_TOKENS_PER_MINUTE=20000
API_MANAGER_DEFAULT_REQUESTS_PER_MINUTE=2
# Provider budgets are intentionally conservative and are treated as shared
# account/project/org budgets by default. Do not multiply limits by key count
# unless those keys are verified separate accounts/projects and you set
# PROVIDER_LIMIT_SCOPE=key for that provider.
GEMINI_DAILY_TOKEN_LIMIT=800000
GEMINI_DAILY_REQUEST_LIMIT=900
GEMINI_TOKENS_PER_MINUTE=200000
GEMINI_REQUESTS_PER_MINUTE=8
GEMINI_LIMIT_SCOPE=provider
MISTRAL_DAILY_TOKEN_LIMIT=250000
MISTRAL_DAILY_REQUEST_LIMIT=300
MISTRAL_TOKENS_PER_MINUTE=40000
MISTRAL_REQUESTS_PER_MINUTE=4
MISTRAL_LIMIT_SCOPE=provider
GITHUB_DAILY_TOKEN_LIMIT=200000
GITHUB_DAILY_REQUEST_LIMIT=200
GITHUB_TOKENS_PER_MINUTE=20000
GITHUB_REQUESTS_PER_MINUTE=2
GITHUB_LIMIT_SCOPE=provider
OPENROUTER_DAILY_TOKEN_LIMIT=90000
OPENROUTER_DAILY_REQUEST_LIMIT=50
OPENROUTER_TOKENS_PER_MINUTE=30000
OPENROUTER_REQUESTS_PER_MINUTE=20
OPENROUTER_SOFT_CAP_RATIO=0.70
OPENROUTER_MINUTE_SOFT_CAP_RATIO=0.80
OPENROUTER_LIMIT_SCOPE=provider
GROQ_DAILY_TOKEN_LIMIT=500000
GROQ_DAILY_REQUEST_LIMIT=1000
GROQ_TOKENS_PER_MINUTE=120000
GROQ_REQUESTS_PER_MINUTE=12
GROQ_LIMIT_SCOPE=provider
CEREBRAS_DAILY_TOKEN_LIMIT=250000
CEREBRAS_DAILY_REQUEST_LIMIT=300
CEREBRAS_TOKENS_PER_MINUTE=40000
CEREBRAS_REQUESTS_PER_MINUTE=4
CEREBRAS_LIMIT_SCOPE=provider
FIREWORKS_DAILY_TOKEN_LIMIT=250000
FIREWORKS_DAILY_REQUEST_LIMIT=300
FIREWORKS_TOKENS_PER_MINUTE=40000
FIREWORKS_REQUESTS_PER_MINUTE=4
FIREWORKS_LIMIT_SCOPE=provider
CLOUDFLARE_DAILY_TOKEN_LIMIT=250000
CLOUDFLARE_DAILY_REQUEST_LIMIT=300
CLOUDFLARE_TOKENS_PER_MINUTE=40000
CLOUDFLARE_REQUESTS_PER_MINUTE=4
CLOUDFLARE_LIMIT_SCOPE=provider
NVIDIA_DAILY_TOKEN_LIMIT=200000
NVIDIA_DAILY_REQUEST_LIMIT=200
NVIDIA_TOKENS_PER_MINUTE=30000
NVIDIA_REQUESTS_PER_MINUTE=3
NVIDIA_LIMIT_SCOPE=provider

# Vision OCR fallback is API-gated and used only when local OCR fails.
USE_API_VISION_OCR=auto
# Strongest-currently-healthy-first; locked providers are skipped for free
# and resume automatically once keys are rotated.
VISION_OCR_PROVIDER_ORDER=nvidia,groq,openrouter,gemini,github
GEMINI_VISION_OCR_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GITHUB_VISION_OCR_MODELS=openai/gpt-4o-mini,openai/gpt-4o
GROQ_VISION_OCR_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_VISION_OCR_MODELS=qwen/qwen2.5-vl-72b-instruct:free,qwen/qwen2.5-vl-72b-instruct,google/gemini-2.5-flash
VISION_OCR_MAX_TOKENS=2048
VISION_OCR_TIMEOUT_SECONDS=60

# Shadow-mode only (2026-07-16): when on, Step 6 asks a cheap model to
# arbitrate the ~1-2% of classify_text_by_content calls that its own code
# comments admit are low-confidence (Rule B/C, final noise catch-all), and
# logs agreement/disagreement via write_diagnostic_event. The API verdict is
# NEVER applied to actual classification this round -- this only gathers
# accuracy data given classify_text_by_content's documented regression
# history. Default off; the offline sample suite never turns this on.
USE_API_DIALOGUE_CLASSIFIER=0

# Optional high-quality inpainting backend for difficult floating text.
# When set, Step 4 writes a crop and mask to a temp folder, runs this command,
# then reads the produced output image. Supported placeholders:
#   {image} or {input} = input crop path
#   {mask}             = 255-white inpaint mask path
#   {output}           = output crop path that the command must write
# Example shape:
# MANGA_INPAINT_COMMAND=python path\to\your_inpaint_runner.py --image "{image}" --mask "{mask}" --output "{output}"
# Built-in IOPaint adapter example, if IOPaint is installed:
# MANGA_INPAINT_COMMAND=python python/runtime/iopaint_inpaint_backend.py --input "{input}" --mask "{mask}" --output "{output}" --model migan
MANGA_INPAINT_COMMAND=
MANGA_INPAINT_COMMAND_TIMEOUT=180

# Optional dedicated manga line-art cleaner for monochrome/detail-sensitive floating text.
# Values: off (safe default), auto (use when weights exist), force (diagnostics only).
MANGA_CLEANER_BACKEND=off
MANGA_CLEANER_MODEL_DIR=models/manga_cleaner/ComfyUI/models/lama

# Optional diagnostic fallback for high-risk floating text.
# Keep this off for production because it draws English over original source text
# instead of cleaning/reconstructing the source strokes.
MANGA_SOURCE_COVER_FALLBACK=off
